GRENA_CLOUD=1
GRENA_DATA_DIR=/data
# Después de generar el dominio Railway, ponlo completo, sin / final:
GRENA_PUBLIC_URL=https://TU-DOMINIO.up.railway.app
# Secreto: configúralo en Railway Variables, nunca en el código:
GRENA_FISH_API_KEY=
# Opcional. Por seguridad, después del primer usuario el registro se cierra.
GRENA_ALLOW_REGISTRATION=0
