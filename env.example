GRENA_CLOUD=1
GRENA_DATA_DIR=/data
# Después de generar el dominio Railway, ponlo completo, sin / final:
GRENA_PUBLIC_URL=https://TU-DOMINIO.up.railway.app
# Secreto: configúralo en Railway Variables, nunca en el código:
GRENA_FISH_API_KEY=


# Recuperación de contraseña por correo (Resend)
# Crea una API key en Resend y configura estas variables en Railway.
GRENA_MAIL_PROVIDER=resend
RESEND_API_KEY=
# Debe ser un remitente/dominio autorizado en Resend, por ejemplo:
GRENA_MAIL_FROM=
GRENA_MAIL_NAME=GREÑA ID
